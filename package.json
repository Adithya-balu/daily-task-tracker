{
  "name": "daily-focus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A focus-first daily task manager with per-task Pomodoro and resume notes.",
  "scripts": {
    "dev": "vite",
    "dev:detach": "bash scripts/dev-daemon.sh start",
    "dev:stop": "bash scripts/dev-daemon.sh stop",
    "dev:status": "bash scripts/dev-daemon.sh status",
    "build": "tsc -b && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
