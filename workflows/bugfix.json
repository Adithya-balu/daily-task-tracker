{
  "workflow": "bugfix",
  "version": 1,
  "description": "Small fixes: implement straight away, test, review, then wait for merge approval.",
  "stages": {
    "implement": {
      "type": "agent",
      "agent": "coder",
      "mode": "implement",
      "next": { "done": "ci" }
    },
    "ci": {
      "type": "command",
      "run": "{{project.ciCommand}}",
      "next": { "pass": "review", "fail": "implement" }
    },
    "review": {
      "type": "agent",
      "agent": "reviewer",
      "next": { "approved": "merge_approval", "changes_requested": "implement" }
    },
    "merge_approval": {
      "type": "gate",
      "show": "diff",
      "next": { "approved": "done", "rejected": "implement" }
    }
  },
  "limits": {
    "max_loops": 2,
    "max_cost_usd": 2,
    "timeout_minutes": 30
  }
}
